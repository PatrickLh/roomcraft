# RoomCraft AI Provider 配置
# 复制为 .env 并填写。密钥仅存后端环境，绝不进入浏览器端或仓库。
# provider 取值：openai_compatible | mock

# ---- 视觉大模型（Spike A / M1 户型解析）----
ROOMCRAFT_VISION_PROVIDER=mock
# openai_compatible 示例（阿里云百炼兼容模式）：
#   ROOMCRAFT_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   ROOMCRAFT_VISION_MODEL=qwen-vl-max
ROOMCRAFT_VISION_BASE_URL=
ROOMCRAFT_VISION_API_KEY=
ROOMCRAFT_VISION_MODEL=

# ---- 生图模型（Spike B / M3 风格效果图）----
ROOMCRAFT_IMAGE_PROVIDER=mock
# openai_compatible 示例（火山方舟兼容模式，参考图生图走 image 扩展参数，见 providers/openai_compatible.py 说明）：
#   ROOMCRAFT_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#   ROOMCRAFT_IMAGE_MODEL=doubao-seedream-4-0
ROOMCRAFT_IMAGE_BASE_URL=
ROOMCRAFT_IMAGE_API_KEY=
ROOMCRAFT_IMAGE_MODEL=
